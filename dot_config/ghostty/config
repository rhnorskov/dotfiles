theme = Dracula

font-family = FiraCode Nerd Font Mono Med
font-size = 14
font-feature = +calt
font-feature = +liga
font-feature = +dlig
adjust-cell-height = 20%
macos-option-as-alt = left
# Faint darkening of unfocused splits (cmux panes); the overlay also dims text, so keep it light
unfocused-split-fill = #191a21
unfocused-split-opacity = 0.93
