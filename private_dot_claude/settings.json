{
	"respectGitignore": false,
	"attribution": {
		"commit": "",
		"pr": "",
		"sessionUrl": false
	},
	"permissions": {
		"allow": [
			"mcp__plugin_context7_context7__resolve-library-id",
			"mcp__plugin_context7_context7__query-docs",
			"mcp__papi__id_convert",
			"mcp__papi__id_decode",
			"mcp__papi__id_encode",
			"mcp__papi__id_query",
			"mcp__papi__pf_get_config",
			"mcp__papi__pf_list",
			"mcp__papi__pf_start_redis",
			"mcp__papi__pf_start_service",
			"mcp__papi__pf_stop",
			"WebSearch",
			"WebFetch"
		],
		"defaultMode": "auto"
	},
	"statusLine": {
		"type": "command",
		"command": "bunx -y ccstatusline@latest",
		"padding": 0,
		"refreshInterval": 10
	},
	"enabledPlugins": {
		"context7@context7-marketplace": true,
		"datadog@claude-plugins-official": true,
		"frontend-design@claude-plugins-official": true,
		"github@claude-plugins-official": true,
		"mattpocock-skills@claude-plugins-official": true,
		"rust-analyzer-lsp@claude-plugins-official": true,
		"swift-lsp@claude-plugins-official": true,
		"typescript-lsp@claude-plugins-official": true
	},
	"extraKnownMarketplaces": {
		"context7-marketplace": {
			"source": {
				"source": "github",
				"repo": "upstash/context7"
			}
		}
	},
	"ultracode": true,
	"advisorModel": "fable",
	"tui": "fullscreen",
	"voice": {
		"enabled": true,
		"mode": "hold"
	},
	"skipDangerousModePermissionPrompt": true,
	"agentPushNotifEnabled": true
}
